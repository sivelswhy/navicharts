{
  "name": "navicharts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Alternative gratuite à Navigraph basée sur les données aéronautiques publiques",
  "scripts": {
    "data": "node scripts/build-data.ts",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=23.6"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/metropolis": "^5.3.0",
    "maplibre-gl": "^6.11.2",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
